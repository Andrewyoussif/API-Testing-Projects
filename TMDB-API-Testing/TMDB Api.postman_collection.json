    {
      "name": "Now Playing Movies",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Response contains results and dates{} object\",function(){\r",
              "    pm.expect(pm.response.json()).to.have.property('results' && 'dates')\r",
              "    pm.expect(pm.response.json().results).to.be.an('array')\r",
              "    pm.expect(pm.response.json().dates).to.be.an('object')\r",
              "})\r",
              "\r",
              "pm.test(\"dates includes: maximum and minimum (date range) fields\",function(){\r",
              "    pm.expect(pm.response.json().dates).to.have.property('maximum' && 'minimum')\r",
              "})\r",
              "\r",
              "pm.test(\"Each movie includes: id, title, release_date, vote_count\", function () {\r",
              "    const genres = pm.response.json().results;\r",
              "\r",
              "    genres.forEach(genre => {\r",
              "        pm.expect(genre).to.have.property('id');\r",
              "        pm.expect(genre).to.have.property('title');\r",
              "        pm.expect(genre).to.have.property('release_date');\r",
              "        pm.expect(genre).to.have.property('vote_count');\r",
              "    });\r",
              "});\r",
              "\r",
              "pm.test(\"Confirm results are within the valid date range\", function () {\r",
              "    const response = pm.response.json();\r",
              "    const minDate = new Date(response.dates.minimum);\r",
              "    const maxDate = new Date(response.dates.maximum);\r",
              "\r",
              "    response.results.forEach(movie => {\r",
              "        if (!movie.release_date) return; \r",
              "\r",
              "        const releaseDate = new Date(movie.release_date);\r",
              "        pm.expect(releaseDate).to.be.at.least(minDate);\r",
              "        pm.expect(releaseDate).to.be.at.most(maxDate);\r",
              "    });\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
